#include<stdio.h>
#define N 10


int main(){

	int vector[N] = {1,6,3,5,6,8,3,2,7,2};


	bool intercambio = false; //para empezar nisiquiera entrara a la condi
	int i;
	int j;
				      //            
	for(i=0;i<N-1;i++){
		for(j=0;j<N;j++){
				      
			if(vector[j] < vector[i]){
				
				intercambio = true;                       
				int aux = vector[i];
			       	vector[i]= vector[j];            
		    		vector[j]= aux;
			}                                
			else if(vector[j] == vector[i]){                                                                                        	continue;
			}                                                                                                                       if(intercambio){
				j=i+1;
			}
		}
	}

	for(int i=0 i< N; i++){
	
		printf("%d - ", vector[i]);
	}


	
	return 0;
}



