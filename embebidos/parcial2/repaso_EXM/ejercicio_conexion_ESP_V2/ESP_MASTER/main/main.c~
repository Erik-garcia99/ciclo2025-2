void main_task(void *params){


    while(1){

        ESP_LOGI(TAG, "esperando a recibir el dato");

        xEventGroupWaitBits(status_uart, RX_COMPLETE,pdTRUE, pdTRUE, portMAX_DELAY);
        ESP_LOGI(TAG, "recibido");
        uart_write_bytes(UART_SEL, input, strlen((char*)input));
        uart_write_bytes(UART_SEL, "\r\n", 2);

        //mandamos los datos al esclavo, esto es nomas hace eso, manda al esclavo lo que se escribiio por uart  
        // i2c_master_send(input, strlen((char*)input), I2C_SLAVE_ADDR, I2C_PORT);
        
        //funcion para trasmitir al slave 
        i2c_master_transmit(i2c_slave_handler,input,strlen((char*)input), portMAX_DELAY);

        memset(&input, 0, BUFF);
        vTaskDelay(300/portTICK_PERIOD_MS);
    }

